# OpenCLAW 环境变量配置模板
# 复制此文件为 .env 并修改

# ─────────────── PostgreSQL ───────────────
POSTGRES_USER=openclaw
POSTGRES_PASSWORD=change-this-password-in-production
POSTGRES_DB=openclaw

# ─────────────── Redis ───────────────
REDIS_HOST=redis
REDIS_PORT=6379

# ─────────────── NATS ───────────────
NATS_HOST=nats
NATS_PORT=4222

# ─────────────── MinIO ───────────────
MINIO_ACCESS_KEY=openclaw
MINIO_SECRET_KEY=change-this-secret-in-production

# ─────────────── JWT ───────────────
# 生产环境必须修改为足够长的随机字符串
JWT_SECRET_KEY=change-this-jwt-secret-key-in-production-must-be-long

# ─────────────── Grafana ───────────────
GRAFANA_PASSWORD=admin

# ─────────────── App ───────────────
APP_NAME=OpenCLAW
APP_VERSION=V2.2
DEBUG=false
