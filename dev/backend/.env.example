# === 必填凭据（启动时强制检查，缺失则拒绝运行）===
JWT_SECRET_KEY=your-256bit-random-secret-here
POSTGRES_PASSWORD=change-this-password
MINIO_SECRET_KEY=choose-a-strong-password

# === 数据库（可选覆盖）===
POSTGRES_USER=openclaw
POSTGRES_DB=openclaw
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# === Redis（可选覆盖）===
REDIS_HOST=localhost
REDIS_PORT=6379

# === NATS（可选覆盖）===
NATS_HOST=localhost
NATS_PORT=4222

# === MinIO（可选覆盖）===
MINIO_HOST=localhost
MINIO_PORT=9000
MINIO_ACCESS_KEY=openclaw

# === App（可选覆盖）===
APP_NAME=OpenCLAW
APP_VERSION=V2.2
DEBUG=true

# === CORS — 生产环境设置具体域名（JSON 数组格式）===
# CORS_ORIGINS=["https://panel.example.com","https://agent.example.com"]
